  gem 'jekyll-remote-theme', '~> 0.6.2'
  gem 'jekyll-redirect-from', '~> 0.16'
  gem 'jekyll-feed', '~> 0.17'
  gem 'jekyll-sitemap', '~> 1.4'
  # Plugins required by mmistakes/so-simple-theme.
  gem 'jekyll-paginate', '~> 1.1'
  gem 'jekyll-gist', '~> 1.5'
  gem 'jekyll-seo-tag', '~> 2.8'
  # Preserve Pages' rendering of historical Markdown pages without front matter.
  gem 'jekyll-optional-front-matter', '~> 0.3'
  gem 'jekyll-default-layout', '~> 0.1'
  gem 'jekyll-titles-from-headings', '~> 0.5'
  gem 'jekyll-relative-links', '~> 0.6'
end
